# TrustGate frontend environment

# Oracle service base URL (used by /oracle and /agents/live pages)
NEXT_PUBLIC_ORACLE_URL=https://your-oracle-host.example.com

# WalletConnect project ID (optional — get one at https://cloud.walletconnect.com)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only. 0x-prefixed 32-byte hex private key of the hot wallet that
# pays 0.001 USDC per ERC-20 widget query (/api/widget/score/[address]).
# The wallet must hold ERC-20 USDC for transfer value AND Arc native gas
# for tx fees. Without this set, ERC-20 widget queries return 502.
# Never expose with NEXT_PUBLIC_ prefix.
# WIDGET_HOT_WALLET_PRIVATE_KEY=
# Optional spend brakes (defaults: 8 req/min/IP, 40 payments/hour, 200/day)
# WIDGET_IP_MAX_PER_MINUTE=8
# WIDGET_MAX_PAYMENTS_PER_HOUR=40
# WIDGET_MAX_PAYMENTS_PER_DAY=200

# Graph trust proxy (/api/graph-trust). Optional overrides; defaults are fine.
# INTUITION_MCP_URL=https://mcp-trust.intuition.box/mcp
# GRAPH_TRUST_ANCHOR_ADDRESSES=0x...,0x...

# Temporal score weight (token oracle + batch). Default 0 = flags only, no score impact.
# Set to 1 after Arc testnet calibration. Full scoring env list: .env.local.example
# SCORING_TEMPORAL_SCORE_WEIGHT=0
